# Copy to .env.local and fill in. Never commit the real values.

# Resend API key with "Sending access" only. Read server-side by
# src/app/api/reservations/route.ts; the form never sees it.
RESEND_API_KEY=

# The CRM's API. Both are optional: without them the form works exactly as it
# did before, sending mail and nothing else.
#
# The API is at api.misprivateresidence.com — crm. is the interface people sign
# in to, and it has no ingest endpoint of its own.
#
# CRM_INGEST_SECRET must match INGEST_SECRET in the API's environment.
# Generate one with:  openssl rand -base64 48
CRM_INGEST_URL=https://api.misprivateresidence.com/api/ingest/reservations/
CRM_INGEST_SECRET=
