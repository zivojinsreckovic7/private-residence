# Copy to .env.local and fill in. Never commit the real values.

# Resend API key with "Sending access" only. Read server-side by
# src/app/api/reservations/route.ts; the form never sees it.
RESEND_API_KEY=

# The CRM at crm.misprivateresidence.com. Both are optional: without them the
# form works exactly as it did before, sending mail and nothing else.
#
# CRM_INGEST_SECRET must match INGEST_SECRET in the CRM's own environment.
# Generate one with:  openssl rand -base64 48
CRM_INGEST_URL=https://crm.misprivateresidence.com/api/reservations/
CRM_INGEST_SECRET=
